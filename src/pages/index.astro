        usul="Pencatatan golongan darah dianjurkan untuk dilengkapi secara bertahap melalui pendataan di tingkat lingkungan demi kesiapsiagaan aksi kemanusiaan paroki."
      />
      <TabelAlt slot="tabel" judul="distribusi golongan darah umat" keterangan={a("5.6").caption}
        kolom={KOLOM_BAKU} baris={tabelBaris(adegan("5.6").rows)} />
    </Adegan>
  </Pilar>

  {/* ═══ PENUTUP ═══════════════════════════════════════════════════════════ */}
  <section class="pilar penutup-bagian" id="penutup" aria-labelledby="penutup-judul">
    <div class="wrap">
      <div class="pilar__head">
        <span class="pilar__no" aria-hidden="true">06</span>
        <h2 id="penutup-judul">Dari Data Menjadi Pijakan Reksa Pastoral</h2>
      </div>
      <hr class="rule-accent" />

      {/* ── 6.1 ───────────────────────────────────────────────────────────── */}
      <div class="adegan" id="adegan-6-1" data-reveal>
        <div class="adegan__head">
          <span class="adegan__no" aria-hidden="true">6.1</span>
          <h3>{penutupTeks.agendaJudul}</h3>
        </div>
        <p class="prose">{penutupTeks.agendaLead}</p>
        <div class="agenda">
          {
            agenda.map((it, i) => (
              <article class="agenda__kartu">
                <span class="agenda__no">{String(i + 1).padStart(2, "0")}</span>
                <h4>{it.judul}</h4>
                <p>{it.isi}</p>
                <p class="agenda__rujuk">
                  Dari adegan{" "}
                  {it.rujuk.map((r, j) => (
                    <>
                      {j > 0 ? ", " : ""}
                      <a href={`#${anchor(r)}`}>{r}</a>
                    </>
                  ))}
                </p>
              </article>
            ))
          }
        </div>
      </div>

      {/* ── 6.2 ───────────────────────────────────────────────────────────── */}
      <div class="adegan" id="adegan-6-2" data-reveal>
        <div class="adegan__head">
          <span class="adegan__no" aria-hidden="true">6.2</span>
          <h3>{penutupTeks.celahJudul}</h3>
        </div>
        <p class="prose">{penutupTeks.celahLead}</p>

        <div class="figur">
          <table class="metode-tabel">
            <caption>Rincian bidang data sensus dengan proporsi belum tercatat tertinggi, diurutkan dari persentase terbesar.</caption>
            <thead>
              <tr>
                <th scope="col">Bidang Data yang Belum Lengkap</th>
                <th scope="col" class="num">Jumlah Belum Tercatat</th>
                <th scope="col" class="num">Persen</th>
                <th scope="col">Implikasi bagi Pembacaan Data</th>
              </tr>
            </thead>
            <tbody>
              {
                [...penutup.celah_data].sort((x, y) => y.pct - x.pct).map((c) => (
                  <tr>
                    <th scope="row">
                      {c.kolom}
                      {c.adegan && (
                        <>
                          {" "}
                          <a class="rujuk" href={`#${anchor(c.adegan)}`}>adegan {c.adegan}</a>
                        </>
                      )}
                    </th>
                    <td class="num">{n(c.kosong)} dari {n(c.dari)}</td>
                    <td class="num">{p(c.pct)}</td>
                    <td>{c.akibat}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h4 class="sub">{penutupTeks.anomaliJudul}</h4>
        <p class="prose">{penutupTeks.anomaliLead}</p>
        <div class="figur">
          <table class="metode-tabel">
            <caption>Daftar anomali dan perbedaan data yang dilaporkan secara transparan untuk verifikasi.</caption>
            <thead>
              <tr>
                <th scope="col">Catatan Temuan Anomali</th>
                <th scope="col" class="num">Jumlah Kasus</th>
                <th scope="col">Tindak Lanjut Penanganan</th>
              </tr>
            </thead>
            <tbody>
              {
                penutup.anomali.map((an) => (
                  <tr>
                    <th scope="row">{an.temuan}</th>
                    <td class="num">
                      {n(an.jumlah)}
                      {an.kelompok !== null && <span class="kel"> dalam {n(an.kelompok)} kelompok</span>}
                    </td>
                    <td>{an.perlakuan}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h4 class="sub">{penutupTeks.usulanJudul}</h4>
        <ol class="usulan">
          {
            penutup.usulan_pembaruan.map((u) => (
              <li>
                {u.usul}
                {u.besaran !== null && (
                  <span class="usulan__n">
                    {" — "}{n(u.besaran)} {u.satuan}
                  </span>
                )}
                {u.adegan && (
                  <>
                    {" "}
                    <a class="rujuk" href={`#${anchor(u.adegan)}`}>adegan {u.adegan}</a>
                  </>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      {/* ── 6.3 ───────────────────────────────────────────────────────────── */}
      <div class="adegan" id="adegan-6-3" data-reveal>
        <div class="adegan__head">
          <span class="adegan__no" aria-hidden="true">6.3</span>
          <h3>{penutupTeks.metodeJudul}</h3>
        </div>
        <p class="prose">{penutupTeks.metodeLead}</p>

        <div class="metode">
          <table>
            <caption>Parameter dan Informasi Metodologi Sensus Paroki</caption>
            <tbody>
              <tr>
                <th scope="row">Paroki</th>
                <td>{meta.paroki}</td>
              </tr>
              <tr>
                <th scope="row">Tanggal acuan sensus</th>
                <td>
                  {SNAPSHOT}
                  {!meta.snapshot_terkonfirmasi && (
                    <>
                      {" "}
                      <b>(asumsi kerja sementara, menanti konfirmasi)</b>. {meta.snapshot_catatan}
                    </>
                  )}
                </td>
              </tr>
              <tr>
                <th scope="row">Berkas sumber</th>
                <td>
                  <code>umat.dbf</code> ({n(meta.umat_total)} baris), <code>umatkk.dbf</code>{" "}
                  ({n(meta.keluarga_umatkk)} baris), <code>lingkung.dbf</code>{" "}
                  ({n(meta.lingkungan_master)} baris), <code>stasi.dbf</code> ({n(meta.wilayah_total)} baris).
                  Berkas <code>.dbf</code> dibaca dan diolah langsung dari sistem basis data paroki; berkas turunan hasil
                  konversi manual tidak digunakan guna menjamin integritas sumber data tunggal (single source of truth).
                </td>
              </tr>
              <tr>
                <th scope="row">Jumlah keluarga</th>
                <td>
                  Seluruh analisis profil umat memakai basis data {n(meta.keluarga_total)} keluarga dari <code>umat.dbf</code>.
                  Berkas <code>umatkk.dbf</code> mencatat {n(meta.keluarga_umatkk)} keluarga (selisih{" "}
                  {n(meta.selisih_keluarga)} keluarga). Setiap adegan yang memakai berkas kepala keluarga senantiasa menyebut
                  penyebutnya sendiri.
                </td>
              </tr>
              <tr>
                <th scope="row">Jenjang teritorial</th>
                <td>
                  Keuskupan → Paroki → {n(meta.wilayah_total)} Wilayah →{" "}
                  {n(meta.lingkungan_total)} Lingkungan → {n(meta.keluarga_total)} Keluarga →{" "}
                  {n(meta.umat_total)} Jiwa. Daftar resmi memuat {n(meta.lingkungan_master)} lingkungan;{" "}
                  {meta.lingkungan_tanpa_jiwa.length > 0
                    ? `${meta.lingkungan_tanpa_jiwa.join(", ")} tidak memuat satu jiwa pun pada potret ini.`
                    : "seluruhnya memiliki umat terdaftar."}
                </td>
              </tr>
              <tr>
                <th scope="row">Ambang privasi</th>
                <td>
                  Sel bernilai 1 sampai {meta.ambang_penyamaran - 1} jiwa ditampilkan sebagai "disamarkan" guna melindungi kerahasiaan data pribadi warga.
                </td>
              </tr>
              <tr>
                <th scope="row">Pemanfaatan</th>
                <td>
                  Internal. Dokumen ini disusun khusus untuk kepentingan karya reksa pastoral Dewan Paroki Pugeran. Dokumen ini tidak dipublikasikan secara terbuka di internet dan tidak memuat data identitas perorangan, sehingga aman dipergunakan dalam lingkungan paroki maupun media luring.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <h4 class="sub">Lima Prinsip Etika dan Tata Kelola Perlindungan Data</h4>
        <div class="agenda">
          {
            prinsipData.map((pr, i) => (
              <article class="agenda__kartu">
                <span class="agenda__no">{String(i + 1).padStart(2, "0")}</span>
                <h4>{pr.judul}</h4>
                <p>{pr.isi}</p>
              </article>
            ))
          }
        </div>

        <h4 class="sub">{penutupTeks.batasJudul}</h4>
        <ol class="batas-list">
          {
            batasTafsir.map((bt) => (
              <li>
                <b>{bt.judul}</b> {bt.isi}
              </li>
            ))
          }
        </ol>

        <h4 class="sub">{penutupTeks.kamusJudul}</h4>
        <div class="metode">
          <table>
            <caption>
              Glosarium istilah pastoral dan teknis yang dipergunakan dalam penyajian profil umat.
            </caption>
            <thead>
              <tr>
                <th scope="col">Istilah Pastoral / Teknis</th>
                <th scope="col">Penjelasan Makna</th>
              </tr>
            </thead>
            <tbody>
              {
                kamus.map(([istilah, arti]) => (
                  <tr>
                    <th scope="row">{istilah}</th>
                    <td>{arti}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h4 class="sub">{penutupTeks.unduhJudul}</h4>
        <p class="prose">{penutupTeks.unduhLead}</p>
        <div class="unduhan">
          {unduhan.map(([berkas, ket]) => <a href={`./data/${berkas}`} title={ket}>{berkas}</a>)}
        </div>
      </div>
    </div>
  </section>

  {/* ═══ KAKI ══════════════════════════════════════════════════════════════ */}
  <footer class="foot">
    <div class="wrap foot__row">
      <div>
        <p>
          <b>{halaman.judul}</b> — {halaman.subjudul}.<br />
          Potret pangkalan data sensus per {SNAPSHOT}. Dokumen perencanaan pastoral internal Dewan Paroki; tidak diterbitkan daring.
        </p>
        <p class="mono-label">
          Disusun dengan sistem desain SADASA Academy · PT Sadasa Akademi Indonesia
        </p>
      </div>
      <div>
        <img class="foot__mark foot__mark--light" src="./brand/sadasa-logo-red.png" alt="SADASA Academy"
          width="640" height="118" />
        <img class="foot__mark foot__mark--ink" src="./brand/sadasa-logo-white.png" alt="SADASA Academy"
          width="640" height="118" />
      </div>
    </div>
  </footer>
</Cerita>

