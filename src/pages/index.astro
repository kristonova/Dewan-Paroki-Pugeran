---
/**
 * Satu-satunya rute. Cerita panjang dari pembuka sampai penutup.
 *
 * Urutan bacanya mengikat: potret dasar → struktur generasi → hidup menggereja
 * → karya dan penghidupan → titik-titik kerentanan → agenda pastoral dan
 * kejujuran soal data yang belum ada. Ini bukan dashboard: tidak ada filter,
 * tidak ada penelusuran individu, tidak ada pencarian nama.
 */
import Cerita from "../layouts/Cerita.astro";
import Adegan from "../components/Adegan.astro";
import Pilar from "../components/Pilar.astro";
import TabelAlt from "../components/TabelAlt.astro";
import StatCards from "../components/charts/StatCards.astro";
import HorizontalBar from "../components/charts/HorizontalBar.astro";
import PopulationPyramid from "../components/charts/PopulationPyramid.astro";
import HeatTable from "../components/charts/HeatTable.astro";
import DataGapCard from "../components/charts/DataGapCard.astro";
import SebaranLingkungan from "../components/charts/SebaranLingkungan.astro";
import Treemap from "../components/charts/Treemap.astro";
import BubbleScatter from "../components/charts/BubbleScatter.astro";
import KolomLolipop from "../components/charts/KolomLolipop.astro";
import UnitKolom from "../components/charts/UnitKolom.astro";
import RingMeter from "../components/charts/RingMeter.astro";
import ZoomBreakdown from "../components/charts/ZoomBreakdown.astro";
import RasioTanggungan from "../components/charts/RasioTanggungan.astro";
import Dumbbell from "../components/charts/Dumbbell.astro";
import GarisRasio from "../components/charts/GarisRasio.astro";
import TahapanTrack from "../components/charts/TahapanTrack.astro";
import Waffle from "../components/charts/Waffle.astro";
import Hemisiklus from "../components/charts/Hemisiklus.astro";
import BatangDivergen from "../components/charts/BatangDivergen.astro";
import UnitKluster from "../components/charts/UnitKluster.astro";
import KotakBersarang from "../components/charts/KotakBersarang.astro";

import {
  adegan, angka, kelompok, lingkunganRows, meta, nilai, objek, penutup, pyramidRows,
  type Row,
} from "../lib/data";
import { anchor, d, n, p, sel, tanggal } from "../lib/format";
import {
  adeganTeks, agenda, babak, batasTafsir, halaman, kamus, pembuka, pilar,
  penutupTeks, prinsipData,
} from "../i18n/id";

const SNAPSHOT = tanggal(meta.snapshot);

/** Baris tabel angka alternatif baku: label, jumlah, persentase. */
const tabelBaris = (rows: Row[]) =>
  rows.map((r) => [r.label, sel(r.n, r.disamarkan), r.pct === null ? "–" : p(r.pct)]);

const KOLOM_BAKU = [{ judul: "Kategori" }, { judul: "Jiwa", num: true }, { judul: "Persen", num: true }];

const a = (id: string) => adeganTeks(id);
const s = (id: string) => adegan(id).sumber;

const PENYEBUT_UMAT = `dari ${n(meta.umat_total)} jiwa terdaftar`;

/** Persentase satu baris adegan menurut labelnya; 0 bila disamarkan. */
const pctBaris = (id: string, label: string) => adegan(id).rows.find((r) => r.label === label)?.pct ?? 0;

/** Jumlah beberapa baris adegan; baris yang disamarkan tidak ikut dijumlahkan. */
const jumlahBaris = (id: string, label: string[]) =>
  adegan(id).rows.filter((r) => label.includes(r.label)).reduce((t, r) => t + (r.n ?? 0), 0);

// Tooltip treemap wilayah menyebut jumlah lingkungannya.
const lingkunganPerWilayah = Object.fromEntries(
  adegan("1.2").rows.map((w) => [
    w.label,
    `${adegan("1.3").rows.filter((r) => r.wilayah === w.label).length} lingkungan`,
  ]),
);

// Adegan 1.6: suku terbesar menjadi bagian dominan, sisanya dirinci.
const sukuTerbesar = objek<{ label: string; n: number }>("1.6", "terbesar");
const rincianSuku = adegan("1.6").rows.filter((r) => r.label !== sukuTerbesar.label);

// Adegan 3.2 memuat sebelas kategori; waffle melipatnya menjadi lima kelompok.
const AGAMA_SEBELUMNYA = adegan("3.2").rows
  .filter((r) => r.label.startsWith("Sebelumnya ") && r.n !== null)
  .map((r) => r.label);
const JALAN_LAIN_32 = ["Jalan lain", "Masih katekumen", "Belum dibaptis", "Diterima dari gereja Kristen lain"];
const SAMAR_32 = adegan("3.2").rows.filter((r) => r.n === null).map((r) => r.label);

// Berkas unduhan data agregat untuk perencanaan karya reksa pastoral Dewan Paroki.
const unduhan = [
  ["lingkungan.csv", "Ringkasan 88 lingkungan dan indeks prioritas sapaan pastoral"],
  ["wilayah.csv", "Sebaran jumlah umat di 19 wilayah"],
  ["piramida_usia.csv", "Data piramida usia umat dalam kelompok lima tahunan"],
  ["ukuran_rumah_tangga.csv", "Sebaran jumlah anggota keluarga"],
  ["pendidikan.csv", "Jenjang pendidikan formal yang ditamatkan umat"],
  ["pekerjaan.csv", "Daftar lengkap 74 kategori profesi dan karya umat"],
  ["bidang_studi.csv", "Daftar lengkap 66 rumpun bidang studi keilmuan umat"],
  ["suku.csv", "Keragaman latar belakang suku umat paroki"],
  ["status_perkawinan.csv", "Sebaran status perkawinan umat menurut hukum Gereja"],
  ["status_gereja.csv", "Tingkat keaktifan umat di gereja paroki dan lingkungan"],
  ["status_kesehatan.csv", "Catatan kebutuhan kesehatan khusus umat"],
  ["golongan_darah.csv", "Distribusi golongan darah untuk kesiapsiagaan kemanusiaan"],
  ["waktu_baptis.csv", "Waktu dan jalur penerimaan Sakramen Baptis"],
  ["agama.csv", "Komposisi agama seluruh anggota keluarga"],
  ["keterlibatan.csv", "Ragam keterlibatan tugas pelayanan pastoral"],
  ["tempat_tinggal.csv", "Persebaran tempat tinggal dan domisili perantauan umat"],
  ["ekonomi_keluarga.csv", "Kondisi ekonomi keluarga menurut pencatatan sensus"],
];
---

<Cerita judul={`${halaman.judul} — ${halaman.subjudul}`} deskripsi={halaman.deskripsi}>
  {/* ═══ PEMBUKA 0.0 ═══════════════════════════════════════════════════════ */}
  <section class="hero" id="pembuka" aria-labelledby="pembuka-judul">
    <div class="wrap">
      <img class="hero__mark" src="./brand/sadasa-logo-white.png" alt="SADASA Academy" width="640" height="118" />
      <span class="eyebrow hero__eyebrow">{pembuka.eyebrow}</span>
      <h1 id="pembuka-judul">{pembuka.judul}</h1>
      <p class="hero__lead">{pembuka.lead}</p>

      <div class="hero__figures">
        {
          adegan("0.0").rows.map((r) => (
            <div class="hero__figure">
              <span class="n" data-count={r.n ?? 0}>{n(r.n)}</span>
              <span class="l">{r.label}</span>
            </div>
          ))
        }
      </div>

      <p class="hero__note">{pembuka.catatan}</p>
    </div>
  </section>

  {/* ═══ BABAK I ═══════════════════════════════════════════════════════════ */}
  <section class="babak" id={babak[0]!.id}>
    <div class="wrap">
      <span class="babak__label">{babak[0]!.label}</span>
      <h2>{babak[0]!.judul}</h2>
      <p class="babak__lead">{babak[0]!.lead}</p>
    </div>
  </section>

  {/* ═══ PILAR 1 ═══════════════════════════════════════════════════════════ */}
  <Pilar no={pilar[0]!.no} id={pilar[0]!.id} judul={pilar[0]!.judul} bidang={pilar[0]!.bidang} lead={pilar[0]!.lead}>
    <Adegan id="1.1" pertanyaan={a("1.1").pertanyaan} tafsir={a("1.1").tafsir} sumber={s("1.1")}>
      <StatCards
        judul={a("1.1").label}
        kartu={[
          { nilai: meta.umat_total, label: "jiwa terdaftar", sorot: true },
          { nilai: meta.keluarga_total, label: "keluarga" },
          { nilai: d(angka("1.1", "rata_rata_per_keluarga"), 2), label: "rata-rata anggota per keluarga",
            sub: `nilai tengah (median) ${d(angka("1.1", "median_per_keluarga"), 0)}` },
          { nilai: angka("1.1", "terbesar"), label: "anggota pada keluarga terbesar" },
        ]}
      />
      <TabelAlt
        slot="tabel"
        judul="profil dasar demografi paroki"
        keterangan={a("1.1").caption}
        kolom={[{ judul: "Indikator" }, { judul: "Nilai", num: true }]}
        baris={[
          ["Jiwa terdaftar", n(meta.umat_total)],
          ["Jumlah keluarga", n(meta.keluarga_total)],
          ["Rata-rata anggota per keluarga", d(angka("1.1", "rata_rata_per_keluarga"), 2)],
          ["Nilai tengah (median) per keluarga", d(angka("1.1", "median_per_keluarga"), 0)],
          ["Anggota pada keluarga terbesar", n(angka("1.1", "terbesar"))],
          ["Jumlah lingkungan", n(meta.lingkungan_total)],
          ["Jumlah wilayah", n(meta.wilayah_total)],
        ]}
      />
    </Adegan>

    <Adegan id="1.2" pertanyaan={a("1.2").pertanyaan} tafsir={a("1.2").tafsir} sumber={s("1.2")}>
      <Treemap
        rows={adegan("1.2").rows}
        caption={a("1.2").caption}
        label={a("1.2").label}
        kelompok={kelompok}
        penyebutLabel={`dari ${n(adegan("1.2").penyebut)} jiwa berkode wilayah Pugeran`}
        ekstra={lingkunganPerWilayah}
      />
      <TabelAlt
        slot="tabel"
        judul="sebaran jumlah umat menurut wilayah"
        keterangan={a("1.2").caption}
        kolom={[{ judul: "Wilayah" }, { judul: "Kelompok" }, { judul: "Jiwa", num: true }, { judul: "Persen", num: true }]}
        baris={adegan("1.2").rows.map((r) => [r.label, r.kelompok ?? "–", sel(r.n, r.disamarkan), p(r.pct)])}
      />
    </Adegan>

    <Adegan id="1.3" pertanyaan={a("1.3").pertanyaan} tafsir={a("1.3").tafsir} sumber={s("1.3")}>
      <SebaranLingkungan
        rows={adegan("1.3").rows}
        wilayah={adegan("1.2").rows}
        kelompok={kelompok}
        caption={a("1.3").caption}
        label={a("1.3").label}
        median={angka("1.3", "median")}
        sorot={[objek<{ label: string }>("1.3", "terbesar").label, objek<{ label: string }>("1.3", "terkecil").label]}
      />
      <TabelAlt
        slot="tabel"
        judul="sebaran jumlah umat di 88 lingkungan"
        keterangan={a("1.3").caption}
        gulir
        kolom={[{ judul: "Lingkungan" }, { judul: "Wilayah" }, { judul: "Kelompok" }, { judul: "Jiwa", num: true }, { judul: "Persen", num: true }]}
        baris={adegan("1.3").rows.map((r) => [r.label, r.wilayah ?? "–", r.kelompok ?? "–", sel(r.n, r.disamarkan), p(r.pct)])}
      />
    </Adegan>

    <Adegan id="1.4" pertanyaan={a("1.4").pertanyaan} tafsir={a("1.4").tafsir} sumber={s("1.4")}>
      <KolomLolipop
        rows={adegan("1.4").rows}
        caption={a("1.4").caption}
        label={a("1.4").label}
        sorot="1"
        satuan="keluarga"
        akhiran=" anggota keluarga"
        penyebutLabel={`dari ${n(meta.keluarga_total)} keluarga`}
        labelSumbu="jumlah anggota dalam satu keluarga"
      />
      <TabelAlt
        slot="tabel"
        judul="sebaran jumlah anggota keluarga"
        keterangan={a("1.4").caption}
        kolom={[{ judul: "Jumlah anggota keluarga" }, { judul: "Keluarga", num: true }, { judul: "Persen", num: true }]}
        baris={tabelBaris(adegan("1.4").rows)}
      />
    </Adegan>

    <Adegan id="1.5" pertanyaan={a("1.5").pertanyaan} tafsir={a("1.5").tafsir} sumber={s("1.5")}>
      <RingMeter
        caption={a("1.5").caption}
        label={a("1.5").label}
        meter={[{
          judul: "Kepala keluarga perempuan",
          pusat: p(angka("1.5", "perempuan_pct")),
          subPusat: "keluarga dikepalai perempuan",
          segmen: [{ label: "Perempuan", n: angka("1.5", "perempuan"), pct: angka("1.5", "perempuan_pct"), warna: "var(--series-1)" }],
          sisa: { label: "Laki-laki", n: nilai("1.5", "Laki-laki"), pct: pctBaris("1.5", "Laki-laki") },
          penyebutLabel: `dari ${n(angka("1.5", "penyebut"))} kepala keluarga yang jenis kelaminnya tercatat`,
          satuan: "kepala keluarga",
          keterangan: `${n(angka("1.5", "tidak_tercatat"))} kepala keluarga belum tercatat jenis kelaminnya.`,
        }]}
      />
      <TabelAlt
        slot="tabel"
        judul="komposisi jenis kelamin kepala keluarga"
        keterangan={a("1.5").caption}
        kolom={KOLOM_BAKU}
        baris={[
          ...tabelBaris(adegan("1.5").rows),
          ["Tidak tercatat", n(angka("1.5", "tidak_tercatat")), "–"],
          ["Total kepala keluarga terdaftar", n(angka("1.5", "total_kk")), "–"],
        ]}
      />
    </Adegan>

    <Adegan id="1.6" pertanyaan={a("1.6").pertanyaan} tafsir={a("1.6").tafsir} sumber={s("1.6")}>
      <ZoomBreakdown
        caption={a("1.6").caption}
        label={a("1.6").label}
        total={{ label: "Umat terdaftar", n: meta.umat_total }}
        dominan={{ label: `Suku ${sukuTerbesar.label}`, n: sukuTerbesar.n }}
        fokus={{ label: "suku lainnya dan belum tercatat", n: meta.umat_total - sukuTerbesar.n }}
        rincian={rincianSuku}
        rincianPenyebut={PENYEBUT_UMAT}
        sorot={rincianSuku[0] ? [rincianSuku[0].label] : []}
      />
      <TabelAlt
        slot="tabel"
        judul="keragaman latar belakang suku umat"
        keterangan={a("1.6").caption}
        kolom={KOLOM_BAKU}
        baris={tabelBaris(adegan("1.6").rows)}
      />
    </Adegan>
  </Pilar>

  {/* ═══ PILAR 2 ═══════════════════════════════════════════════════════════ */}
  <Pilar no={pilar[1]!.no} id={pilar[1]!.id} judul={pilar[1]!.judul} bidang={pilar[1]!.bidang} lead={pilar[1]!.lead}>
    <Adegan id="2.1" pertanyaan={a("2.1").pertanyaan} tafsir={a("2.1").tafsir} sumber={s("2.1")}>
      <PopulationPyramid
        rows={pyramidRows("2.1")}
        caption={a("2.1").caption}
        label={a("2.1").label}
        snapshot={SNAPSHOT}
        median={angka("2.1", "median_umur")}
      />
      <TabelAlt
        slot="tabel"
        judul="struktur piramida usia umat"
        keterangan={a("2.1").caption}
        gulir
        kolom={[{ judul: "Rentang usia" }, { judul: "Laki-laki", num: true }, { judul: "Perempuan", num: true }, { judul: "Belum tercatat", num: true }]}
        baris={pyramidRows("2.1").map((r) => [
          r.label, sel(r.laki.n, r.laki.disamarkan), sel(r.perempuan.n, r.perempuan.disamarkan),
          sel(r.tidak_tercatat.n, r.tidak_tercatat.disamarkan),
        ])}
      />
    </Adegan>

    <Adegan id="2.2" pertanyaan={a("2.2").pertanyaan} tafsir={a("2.2").tafsir} sumber={s("2.2")}>
      <RasioTanggungan
        rows={adegan("2.2").rows}
        rasioAnak={angka("2.2", "rasio_anak")}
        rasioLansia={angka("2.2", "rasio_lansia")}
        rasioTotal={angka("2.2", "rasio_ketergantungan")}
        caption={a("2.2").caption}
        label={a("2.2").label}
      />
      <TabelAlt
        slot="tabel"
        judul="komposisi kelompok usia dan rasio ketergantungan"
        keterangan={a("2.2").caption}
        kolom={KOLOM_BAKU}
        baris={[
          ...tabelBaris(adegan("2.2").rows),
          ["Rasio ketergantungan", d(angka("2.2", "rasio_ketergantungan"), 1), "–"],
          ["Usia belum dapat dihitung", n(meta.umur_tidak_dapat_dihitung), "–"],
        ]}
      />
    </Adegan>

    <Adegan id="2.3" pertanyaan={a("2.3").pertanyaan} tafsir={a("2.3").tafsir} sumber={s("2.3")}>
      <UnitKolom
        rows={adegan("2.3").rows}
        caption={a("2.3").caption}
        label={a("2.3").label}
        sorot="0–4 tahun"
        penyebutLabel={`dari ${n(angka("2.3", "penyebut"))} anak berusia di bawah 15 tahun`}
      />
      <TabelAlt
        slot="tabel"
        judul="perbandingan tiga kelompok usia anak"
        keterangan={a("2.3").caption}
        kolom={KOLOM_BAKU}
        baris={tabelBaris(adegan("2.3").rows)}
      />
    </Adegan>

    <Adegan id="2.4" pertanyaan={a("2.4").pertanyaan} tafsir={a("2.4").tafsir} sumber={s("2.4")}>
      <RingMeter
        caption={a("2.4").caption}
        label={a("2.4").label}
        meter={[{
          judul: "Kaum muda berusia 15–29 tahun",
          pusat: p(pctBaris("2.4", "15–29 tahun")),
          subPusat: "dari seluruh umat",
          segmen: [
            { label: "15–19 tahun", n: angka("2.4", "umur_15_19"), pct: (100 * angka("2.4", "umur_15_19")) / meta.umat_total, warna: "var(--ramp-3)" },
            { label: "20–24 tahun", n: angka("2.4", "umur_20_24"), pct: (100 * angka("2.4", "umur_20_24")) / meta.umat_total, warna: "var(--ramp-4)" },
            { label: "25–29 tahun", n: angka("2.4", "umur_25_29"), pct: (100 * angka("2.4", "umur_25_29")) / meta.umat_total, warna: "var(--ramp-5)" },
          ],
          sisa: { label: "Umat lainnya", n: meta.umat_total - nilai("2.4", "15–29 tahun"), pct: 100 - pctBaris("2.4", "15–29 tahun") },
          penyebutLabel: PENYEBUT_UMAT,
          satuan: "jiwa",
          keterangan: "Sebaran jumlah kaum muda relatif berimbang di ketiga rentang usia (masing-masing 800–880 jiwa).",
        }]}
      />
      <TabelAlt
        slot="tabel"
        judul="komposisi kelompok usia muda (15–29 tahun)"
        keterangan={a("2.4").caption}
        kolom={KOLOM_BAKU}
        baris={[
          ["15–19 tahun", n(angka("2.4", "umur_15_19")), p((100 * angka("2.4", "umur_15_19")) / meta.umat_total)],
          ["20–24 tahun", n(angka("2.4", "umur_20_24")), p((100 * angka("2.4", "umur_20_24")) / meta.umat_total)],
          ["25–29 tahun", n(angka("2.4", "umur_25_29")), p((100 * angka("2.4", "umur_25_29")) / meta.umat_total)],
          ["Total usia 15–29 tahun", n(nilai("2.4", "15–29 tahun")), p(adegan("2.4").rows[0]?.pct ?? null)],
        ]}
      />
    </Adegan>

    <Adegan id="2.5" pertanyaan={a("2.5").pertanyaan} tafsir={a("2.5").tafsir} sumber={s("2.5")}>
      <Dumbbell rows={pyramidRows("2.5")} caption={a("2.5").caption} label={a("2.5").label} />
      <TabelAlt
        slot="tabel"
        judul="profil umat lanjut usia (65 tahun ke atas)"
        keterangan={a("2.5").caption}
        kolom={[{ judul: "Rentang usia" }, { judul: "Laki-laki", num: true }, { judul: "Perempuan", num: true }, { judul: "Belum tercatat", num: true }]}
        baris={[
          ...pyramidRows("2.5").map((r) => [
            r.label, sel(r.laki.n, r.laki.disamarkan), sel(r.perempuan.n, r.perempuan.disamarkan),
            sel(r.tidak_tercatat.n, r.tidak_tercatat.disamarkan),
          ]),
          ["Total usia 65 tahun ke atas", "–", "–", n(angka("2.5", "lansia_65"))],
          ["Total usia 80 tahun ke atas", "–", "–", n(angka("2.5", "lansia_80"))],
        ]}
      />
    </Adegan>

    <Adegan id="2.6" pertanyaan={a("2.6").pertanyaan} tafsir={a("2.6").tafsir} sumber={s("2.6")}>
      <GarisRasio
        titik={objek<{ label: string; laki: number; perempuan: number; rasio: number | null }[]>("2.6", "per_kelompok_umur")}
        rasioTotal={angka("2.6", "rasio_jenis_kelamin")}
        totalLaki={nilai("2.6", "Laki-laki")}
        totalPerempuan={nilai("2.6", "Perempuan")}
        tidakTercatat={angka("2.6", "tidak_tercatat")}
        caption={a("2.6").caption}
        label={a("2.6").label}
        idUnik="rasio-26"
      />
      <TabelAlt
        slot="tabel"
        judul="rasio jenis kelamin menurut kelompok usia"
        keterangan="Rasio jumlah laki-laki per 100 perempuan pada setiap kelompok rentang usia lima belas tahunan."
        kolom={[{ judul: "Rentang usia" }, { judul: "Laki-laki", num: true }, { judul: "Perempuan", num: true }, { judul: "Laki-laki per 100 perempuan", num: true }]}
        baris={objek<{ label: string; laki: number; perempuan: number; rasio: number | null }[]>("2.6", "per_kelompok_umur")
          .map((r) => [r.label, n(r.laki), n(r.perempuan), r.rasio === null ? "–" : d(r.rasio, 1)])}
      />
    </Adegan>
  </Pilar>

