---
/**
 * KotakBersarang — himpunan bagian sebagai persegi bersarang yang luasnya
 * sebanding jumlahnya. Dipakai di adegan 5.3 (lansia yang tinggal sendiri).
 *
 * Rumah tangga satu orang → di antaranya berusia 65+ → di antaranya berusia
 * 75+. Setiap persegi berjangkar di sudut kiri bawah persegi induknya, jadi
 * "di antaranya" terbaca sebagai bentuk. Warna ramp sekuensial satu rona: makin
 * gelap makin dalam.
 */
import type { Row } from "../../lib/data";
import { n, p } from "../../lib/format";
import { css, kontainer, tip } from "../../lib/viz";

interface Props {
  rows: Row[];
  caption: string;
  label: string;
  /** Akhiran persentase tiap tingkat, sesuai urutan baris. */
  penyebutLabel: string[];
  satuan?: string[];
}

const { rows, caption, label, penyebutLabel, satuan = [] } = Astro.props;

const induk = rows[0]?.n ?? 1;
const RAMP = [1, 3, 5];
const tingkat = rows.map((r, i) => ({
  r,
  sisi: 100 * Math.sqrt((r.n ?? 0) / induk),
  langkah: RAMP[i] ?? 5,
  penyebut: penyebutLabel[i] ?? "",
  satuan: satuan[i] ?? "jiwa",
}));
---

<figure class="figur">
  <figcaption>{caption}</figcaption>

  <div class="kb viz" {...kontainer(label)}>
    <div class="kb__bidang">
      {
        tingkat.map((t) => (
          <div
            class="kb__kotak"
            style={`width:${css(t.sisi)};height:${css(t.sisi)};background:var(--ramp-${t.langkah});color:var(--ramp-text-${t.langkah})`}
            data-ramp={t.langkah}
            {...tip({
              judul: t.r.label,
              nilai: `${n(t.r.n)} ${t.satuan}`,
              warna: `var(--ramp-${t.langkah})`,
              baris: [t.r.pct !== null && `${p(t.r.pct)} ${t.penyebut}`],
            })}
          >
            <span class="kb__n">{n(t.r.n)}</span>
            <span class="kb__label">{t.r.label}</span>
          </div>
        ))
      }
    </div>

    <ol class="kb__daftar" role="list">
      {
        tingkat.map((t) => (
          <li>
            <span class="kb__sw" style={`background:var(--ramp-${t.langkah})`} aria-hidden="true" />
            <span class="kb__daftar-n">{n(t.r.n)}</span>
            <span class="kb__daftar-l">
              {t.r.label}
              <small>{p(t.r.pct)} {t.penyebut}</small>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <slot />
</figure>

<style>
  .kb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-10);
  }
  .kb__bidang {
    position: relative;
    flex: 0 1 21rem;
    aspect-ratio: 1;
    min-width: 14rem;
  }
  .kb__kotak {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-3);
    border-top: 2px solid var(--surface-card);
    border-right: 2px solid var(--surface-card);
    border-radius: 0 4px 0 0;
  }
  .kb__n {
    font-size: var(--size-h3);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
  }
  .kb__label {
    max-width: 16ch;
    font-size: var(--size-micro);
    line-height: 1.25;
  }
  .kb__daftar {
    flex: 1 1 16rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kb__daftar li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border-hairline);
  }
  .kb__sw {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    align-self: center;
  }
  .kb__daftar-n {
    font-size: var(--size-h3);
    font-weight: var(--fw-black);
    color: var(--text-strong);
    letter-spacing: var(--tracking-display);
  }
  .kb__daftar-l {
    font-size: var(--size-body-sm);
    color: var(--text-body);
  }
  .kb__daftar-l small {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--size-micro);
    color: var(--text-muted);
  }
</style>
