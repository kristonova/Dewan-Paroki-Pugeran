---
/**
 * StatCards — satu angka adalah satu angka; ia tidak butuh grafik.
 * Dipakai di adegan 0.0, 1.1, 2.4, 3.6, 3.7, 4.6, 5.3.
 */
import { n, p } from "../../lib/format";

export interface Kartu {
  nilai: number | string;
  satuan?: string;
  label: string;
  sub?: string;
  pct?: number | null;
  sorot?: boolean;
}

interface Props {
  kartu: Kartu[];
  judul?: string;
}

const { kartu, judul } = Astro.props;
---

<div class="stats" role="list" aria-label={judul ?? "Angka utama"}>
  {
    kartu.map((k) => (
      <div class:list={["stat", k.sorot && "stat--sorot"]} role="listitem">
        <span class="stat__n">
          {typeof k.nilai === "number" ? n(k.nilai) : k.nilai}
          {k.satuan && <span class="stat__unit">{k.satuan}</span>}
        </span>
        <span class="stat__l">{k.label}</span>
        {(k.sub || (k.pct !== null && k.pct !== undefined)) && (
          <span class="stat__sub">
            {k.pct !== null && k.pct !== undefined ? `${p(k.pct)} dari seluruh umat` : ""}
            {k.pct !== null && k.pct !== undefined && k.sub ? " \u00b7 " : ""}
            {k.sub}
          </span>
        )}
      </div>
    ))
  }
</div>
